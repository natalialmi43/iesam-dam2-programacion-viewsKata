<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="16dp">

    <TextView
        android:id="@+id/label_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rl_label_name" />

    <TextView
        android:id="@+id/label_surname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rl_label_surname"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@id/label_name"/>

    <TextView
        android:id="@+id/label_surname2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rl_label_surname2"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@id/label_surname"/>

    <TextView
        android:id="@+id/label_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rl_label_age"
        android:layout_marginStart="10dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:id="@+id/label_address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rl_label_address"
        android:layout_below="@id/label_name"/>
    <TextView
        android:id="@+id/label_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rl_label_phone"
        android:layout_below="@id/label_age"
        android:layout_alignParentEnd="true"/>

    <TextView
        android:id="@+id/label_cp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rl_label_cp"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@id/label_address"
        android:layout_below="@id/label_surname2"/>


</RelativeLayout>